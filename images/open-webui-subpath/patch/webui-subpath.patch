diff --git a/backend/open_webui/main.py b/backend/open_webui/main.py
index a1abf80..b51b34d 100644
--- a/backend/open_webui/main.py
+++ b/backend/open_webui/main.py
@@ -3201,3 +3201,21 @@ if os.path.exists(FRONTEND_BUILD_DIR):
     )
 else:
     log.warning(f"Frontend build directory not found at '{FRONTEND_BUILD_DIR}'. Serving API only.")
+
+# --- Subpath support (clinical-ai-platform patch) ---
+# Wraps the fully-configured app under WEBUI_SUBPATH so it can be served
+# behind a reverse proxy path prefix (e.g. /webui) without colliding with
+# sibling services on the same domain. Must stay last in this file: it
+# needs every route/mount above to already be attached to `app`.
+_webui_subpath = os.environ.get('WEBUI_SUBPATH', '').rstrip('/')
+if _webui_subpath:
+    _inner_app = app
+    # Route handlers read e.g. `app.state.WEBUI_NAME` off the module-global
+    # `app` name, which this rebinds to the outer wrapper. Hundreds of
+    # `app.state.X = ...` assignments above already ran against the ORIGINAL
+    # app's State object, so the outer app must share that same object
+    # (not get a fresh empty one from `FastAPI()`) for those reads to work,
+    # in addition to reusing `lifespan` for async-initialized state.
+    app = FastAPI(lifespan=lifespan)
+    app.state = _inner_app.state
+    app.mount(_webui_subpath, _inner_app)
