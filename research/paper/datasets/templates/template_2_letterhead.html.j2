<!-- Plantilla 2: membrete + dos columnas de metadatos + tablas por panel con color -->
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Arial, Helvetica, sans-serif; font-size: 11.5px; color: #1a1a1a; margin: 0; }
  .letterhead { background: #0b3d5c; color: #fff; padding: 18px 36px; display: flex; align-items: center; }
  .logo-box { width: 46px; height: 46px; background: #fff; border-radius: 8px; margin-right: 14px; flex-shrink: 0; }
  .letterhead h1 { font-size: 18px; margin: 0; }
  .letterhead .sub { font-size: 10.5px; opacity: .85; margin-top: 2px; }
  .content { padding: 24px 36px; }
  .meta { display: flex; justify-content: space-between; border: 1px solid #ccd7de; border-radius: 6px; padding: 12px 16px; margin-bottom: 20px; }
  .meta .col div { margin-bottom: 3px; }
  .meta .label { color: #5a6b75; font-size: 10px; text-transform: uppercase; letter-spacing: .03em; }
  .panel { margin-bottom: 18px; border: 1px solid #dde3e7; border-radius: 6px; overflow: hidden; }
  .panel-header { background: #e7f0f6; color: #0b3d5c; font-weight: bold; padding: 7px 12px; font-size: 12px; }
  table { width: 100%; border-collapse: collapse; }
  th, td { padding: 6px 12px; text-align: left; }
  th { font-size: 10px; text-transform: uppercase; color: #5a6b75; border-bottom: 1px solid #dde3e7; }
  td { border-bottom: 1px solid #eef2f4; font-size: 11.5px; }
  .flag-H { color: #b3261e; font-weight: bold; }
  .flag-L { color: #1a5fb4; font-weight: bold; }
</style>
</head>
<body>
  <div class="letterhead">
    <div class="logo-box"></div>
    <div>
      <h1>{{ lab_name }}</h1>
      <div class="sub">{{ lab_address }} &nbsp;|&nbsp; Tel. {{ lab_phone }}</div>
    </div>
  </div>
  <div class="content">
    <div class="meta">
      <div class="col">
        <div class="label">Paciente</div>
        <div><strong>{{ patient.nombre }}</strong></div>
        <div>{{ patient.edad }} años · {{ patient.sexo }} · ID {{ patient.id }}</div>
      </div>
      <div class="col">
        <div class="label">Reporte</div>
        <div>Folio: {{ folio }}</div>
        <div>Toma: {{ fecha_toma }} · Emisión: {{ fecha_reporte }}</div>
        <div>Solicita: {{ medico_solicitante }}</div>
      </div>
    </div>

    {% for panel in panels %}
    <div class="panel">
      <div class="panel-header">{{ panel.name }}</div>
      <table>
        <thead><tr><th>Analito</th><th>Resultado</th><th>Unidad</th><th>Ref.</th></tr></thead>
        <tbody>
          {% for a in panel.analytes %}
          <tr>
            <td>{{ a.nombre }}</td>
            <td class="{{ 'flag-' + a.bandera if a.bandera else '' }}">{{ a.valor }}</td>
            <td>{{ a.unidad }}</td>
            <td>{{ a.rango_ref }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endfor %}
  </div>
</body>
</html>
