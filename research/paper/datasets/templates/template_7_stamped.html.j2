<!-- Plantilla 7: reporte simple con sello/anotación superpuesta (ruido visual) -->
<!doctype html>
<html>
<head>
<meta charset="utf-8">
<style>
  body { font-family: Georgia, serif; font-size: 12px; color: #111; margin: 30px 40px; position: relative; }
  h1 { font-size: 15px; margin: 0 0 10px; }
  table { width:100%; border-collapse: collapse; margin-top: 10px; }
  th, td { border-bottom:1px solid #ccc; padding:5px 6px; font-size:12px; text-align:left; }
  th { border-bottom: 2px solid #000; }
  .panel-row td { font-weight:bold; background:#f2f2f2; }
  .flag { color:#b00000; font-weight:bold; }
  .stamp {
    position: absolute; top: 90px; right: 70px;
    width: 130px; height: 130px; border: 4px solid #b00000; border-radius: 50%;
    color: #b00000; display:flex; align-items:center; justify-content:center;
    text-align:center; font-family: Arial, sans-serif; font-weight:bold; font-size: 13px;
    transform: rotate(-18deg); opacity: .75; line-height: 1.15;
  }
  .signature {
    position: absolute; bottom: 70px; left: 300px; font-family: 'Brush Script MT', cursive;
    font-size: 26px; color: #1a1a6e; transform: rotate(-4deg);
  }
</style>
</head>
<body>
  <div class="stamp">REVISADO<br>QC LAB<br>08/2026</div>
  <h1>{{ lab_name }} — Reporte de Laboratorio</h1>
  <div>Paciente: {{ patient.nombre }} ({{ patient.edad }}/{{ patient.sexo }}) — Folio {{ folio }}</div>
  <div>Toma: {{ fecha_toma }} — Reporte: {{ fecha_reporte }} — Solicita: {{ medico_solicitante }}</div>
  {% for panel in panels %}
  <table>
    <tr class="panel-row"><td colspan="4">{{ panel.name }}</td></tr>
    <tr><th>Estudio</th><th>Resultado</th><th>Unidad</th><th>Referencia</th></tr>
    {% for a in panel.analytes %}
    <tr>
      <td>{{ a.nombre }}</td>
      <td class="{{ 'flag' if a.bandera else '' }}">{{ a.valor }}</td>
      <td>{{ a.unidad }}</td>
      <td>{{ a.rango_ref }}</td>
    </tr>
    {% endfor %}
  </table>
  {% endfor %}
  <div class="signature">Dr. Ríos Landa</div>
</body>
</html>
